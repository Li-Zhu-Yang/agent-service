# ===== 复制为 .env 后填写 =====

# ---- 大模型（DeepSeek / 任意 OpenAI 兼容服务）----
LLM_API_KEY=sk-xxxxxxxxxxxxxxxxxxxx
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat

# ---- Embedding（向量化）----
# 可选：chroma_local（内置 ONNX 本地模型，免 key，首次使用需联网下载模型）/ dashscope / openai_compatible
# hash 为零依赖离线兜底（质量一般但稳定，配合 BM25 可用）
# 注意：chroma_local 首次下载模型较慢，网络受限时建议用 hash 或提前放置模型
EMBEDDING_PROVIDER=chroma_local
# 当 EMBEDDING_PROVIDER=dashscope 时填写：
# EMBEDDING_API_KEY=
# 当 EMBEDDING_PROVIDER=openai_compatible 时填写：
# EMBEDDING_BASE_URL=
# EMBEDDING_MODEL=

# ---- 数据库（默认 SQLite，开箱即用；docker-compose 起来后切 PostgreSQL）----
# SQLite：DATABASE_URL=sqlite:///./data/ragent.db
# PostgreSQL：DATABASE_URL=postgresql+psycopg://ragent:ragent@localhost:5432/ragent
DATABASE_URL=sqlite:///./data/ragent.db

# ---- Redis（缓存 / 会话记忆 / 限流；无 Redis 自动降级内存）----
REDIS_URL=redis://localhost:6379/0

# ---- JWT 认证 ----
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRE_MINUTES=720

# ---- 客服 Agent 参数 ----
# 会话上下文保留轮数
CONTEXT_WINDOW=10
# 命中高频问答缓存时直接返回（秒）
QA_CACHE_TTL=600
# LLM 单次回答最大 token
LLM_MAX_TOKENS=1024
# 检索超时（秒）
RETRIEVAL_TIMEOUT=5
# 限流：每分钟每个 IP 最大请求数
RATE_LIMIT_PER_MINUTE=60

# ---- 演示账号（scripts/create_admin.py 使用）----
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
